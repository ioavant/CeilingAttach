<Window x:Class="CeilingAttach.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CeilingAttach — Settings"
        Width="320" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- Gap field — label text set from code-behind with the project unit -->
        <TextBlock x:Name="GapLabel"
                   FontSize="13" Height="30" VerticalAlignment="Bottom"/>
        <TextBox x:Name="GapTextBox"
                 PreviewTextInput="NumericOnly_PreviewTextInput" Width="80" HorizontalAlignment="Left"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="Red" FontSize="11"
                   Margin="0,4,0,0" Visibility="Collapsed"/>

        <!-- Search height field — label text set from code-behind -->
        <TextBlock x:Name="SearchLabel"
                   FontSize="13" Height="30" Width="280"
                   ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                   Padding="0,0,0,6" VerticalAlignment="Bottom" Margin="0,20,0,0"/>
        <TextBox x:Name="SearchTextBox"
                 PreviewTextInput="NumericOnly_PreviewTextInput" Width="80" HorizontalAlignment="Left"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    IsDefault="True"
                    Click="OK_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Cancel"
                    IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>
